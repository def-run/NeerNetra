# =============================================================================
# NeerNetra — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# =============================================================================

# --- Database ---
POSTGRES_DB=neernetra
POSTGRES_USER=neernetra
POSTGRES_PASSWORD=neernetra_dev_2026
DATABASE_URL=postgresql://neernetra:neernetra_dev_2026@localhost:5432/neernetra
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Pilot Region ---
PILOT_REGION_NAME=Kedarnath
PILOT_REGION_LAT=30.735
PILOT_REGION_LON=79.066
PILOT_REGION_BBOX_NORTH=30.85
PILOT_REGION_BBOX_SOUTH=30.60
PILOT_REGION_BBOX_EAST=79.20
PILOT_REGION_BBOX_WEST=78.90

# --- Open-Meteo API ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Scheduling ---
PREDICTION_INTERVAL_MINUTES=30
DATA_REFRESH_INTERVAL_MINUTES=15

# --- ML Model ---
MODEL_PATH=ml/saved_models/flood_random_forest.joblib
MODEL_TYPE=random_forest

# --- Logging ---
LOG_LEVEL=INFO
